rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCloudShift(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 120 &&
             data.roleTitle is string && data.roleTitle.size() >= 1 && data.roleTitle.size() <= 120 &&
             data.crmOrRegistry is string && data.crmOrRegistry.size() >= 1 && data.crmOrRegistry.size() <= 60 &&
             data.department is string && data.department.size() >= 1 && data.department.size() <= 100 &&
             data.category is string && (data.category == 'MEDICAL' || data.category == 'ADMIN') &&
             data.shiftStatus is string && (data.shiftStatus == 'CURRENT' || data.shiftStatus == 'UPCOMING' || data.shiftStatus == 'COMPLETED') &&
             data.shiftTimeLabel is string && data.shiftTimeLabel.size() >= 1 && data.shiftTimeLabel.size() <= 80 &&
             data.dateLabel is string && data.dateLabel.size() >= 1 && data.dateLabel.size() <= 80 &&
             data.locationRoom is string && data.locationRoom.size() >= 1 && data.locationRoom.size() <= 120 &&
             data.permissionLevel is string && data.permissionLevel.size() >= 1 && data.permissionLevel.size() <= 100 &&
             data.notes is string && data.notes.size() <= 500 &&
             data.voiceTranscript is string && data.voiceTranscript.size() <= 500 &&
             data.isOnCall is bool &&
             data.createdViaVoice is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCloudClinicalCase(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.projectClinicAnchor is string && data.projectClinicAnchor.size() >= 1 && data.projectClinicAnchor.size() <= 140 &&
             data.clinicUf is string && data.clinicUf.size() >= 2 && data.clinicUf.size() <= 10 &&
             data.clinicSpecialty is string && data.clinicSpecialty.size() >= 1 && data.clinicSpecialty.size() <= 100 &&
             data.caseReference is string && data.caseReference.size() >= 1 && data.caseReference.size() <= 120 &&
             data.responsibleHuman is string && data.responsibleHuman.size() >= 1 && data.responsibleHuman.size() <= 140 &&
             data.declaredPurpose is string && data.declaredPurpose.size() >= 1 && data.declaredPurpose.size() <= 200 &&
             data.contextScope is string && data.contextScope.size() <= 500 &&
             data.evidencias is string && data.evidencias.size() <= 1000 &&
             data.raciocinio is string && data.raciocinio.size() <= 1000 &&
             data.decisao is string && data.decisao.size() <= 1000 &&
             data.deidentificationConfirmed is bool &&
             data.governanceStatus is string && (data.governanceStatus == 'VALID' || data.governanceStatus == 'WEAK' || data.governanceStatus == 'BLOCKED' || data.governanceStatus == 'INVALID') &&
             data.governanceReport is string && data.governanceReport.size() <= 1000 &&
             data.createdViaVoice is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/shifts/{shiftId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(shiftId) && existing().userId == request.auth.uid;
      allow list: if isOwner(userId) && existing().userId == request.auth.uid;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(shiftId) &&
                       incoming().keys().hasAll([
                         'userId', 'staffName', 'roleTitle', 'crmOrRegistry', 'department',
                         'category', 'shiftStatus', 'shiftTimeLabel', 'dateLabel',
                         'locationRoom', 'permissionLevel', 'notes', 'voiceTranscript',
                         'isOnCall', 'createdViaVoice', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'staffName', 'roleTitle', 'crmOrRegistry', 'department',
                         'category', 'shiftStatus', 'shiftTimeLabel', 'dateLabel',
                         'locationRoom', 'permissionLevel', 'notes', 'voiceTranscript',
                         'isOnCall', 'createdViaVoice', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidCloudShift(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(shiftId) &&
                       isValidCloudShift(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'staffName', 'roleTitle', 'crmOrRegistry', 'department',
                         'category', 'shiftStatus', 'shiftTimeLabel', 'dateLabel',
                         'locationRoom', 'permissionLevel', 'notes', 'voiceTranscript',
                         'isOnCall', 'createdViaVoice', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(shiftId) && existing().userId == request.auth.uid;
    }

    match /users/{userId}/clinical_cases/{caseId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(caseId) && existing().userId == request.auth.uid;
      allow list: if isOwner(userId) && existing().userId == request.auth.uid;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(caseId) &&
                       incoming().keys().hasAll([
                         'userId', 'projectClinicAnchor', 'clinicUf', 'clinicSpecialty',
                         'caseReference', 'responsibleHuman', 'declaredPurpose',
                         'contextScope', 'evidencias', 'raciocinio', 'decisao',
                         'deidentificationConfirmed', 'governanceStatus', 'governanceReport',
                         'createdViaVoice', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'projectClinicAnchor', 'clinicUf', 'clinicSpecialty',
                         'caseReference', 'responsibleHuman', 'declaredPurpose',
                         'contextScope', 'evidencias', 'raciocinio', 'decisao',
                         'deidentificationConfirmed', 'governanceStatus', 'governanceReport',
                         'createdViaVoice', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidCloudClinicalCase(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(caseId) &&
                       isValidCloudClinicalCase(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'projectClinicAnchor', 'clinicUf', 'clinicSpecialty',
                         'caseReference', 'responsibleHuman', 'declaredPurpose',
                         'contextScope', 'evidencias', 'raciocinio', 'decisao',
                         'deidentificationConfirmed', 'governanceStatus', 'governanceReport',
                         'createdViaVoice', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(caseId) && existing().userId == request.auth.uid;
    }
  }
}
